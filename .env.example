# Copy to /opt/dockge/stacks/buena/.env and fill in values

# Strong random password for the Postgres container
POSTGRES_PASSWORD=changeme

# The public URL of the frontend (used for backend CORS header)
# e.g. https://buena.yourdomain.com
FRONTEND_URL=https://buena.yourdomain.com

# Optional — leave empty to disable AI extraction
GEMINI_API_KEY=
