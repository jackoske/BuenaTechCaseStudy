# Copy to /opt/dockge/stacks/buena/.env and fill in values

# Strong random password for the Postgres container
POSTGRES_PASSWORD=changeme

# Public URL of the frontend
FRONTEND_URL=https://buena.jackskehan.tech

# Optional — leave empty to disable AI extraction
GEMINI_API_KEY=

# Auth — password gate on the frontend
AUTH_PASSWORD=HIREmeBUENA
# Random secret used as the session cookie value (generate with: openssl rand -hex 32)
AUTH_SECRET=changeme
